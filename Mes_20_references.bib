	doi = {10.23939/mmc2023.04.1093},
	abstract = {In this paper, we study the asymptotic behavior of radial solutions of the following quasi-linear equation with the Hardy potential Δpu+h({\textbar}x{\textbar}){\textbar}u{\textbar}p−2u=0, x∈RN−\{0\}, where 2{\textless}p{\textless}N, h is a radial function on RN−\{0\} such that h({\textbar}x{\textbar})=γ{\textbar}x{\textbar}−p, γ{\textgreater}0 and Δpu=div({\textbar}∇u{\textbar}p−2∇u) is the p-Laplacian operator.  The study strongly depends on the sign of γ−(σ/p∗)p where σ=(N−p)/(p−1) and p∗=p/(p−1).},
	language = {en},
	number = {4},
	urldate = {2026-11-14},
	journal = {Mathematical Modeling and Computing},
	author = {{LaR2A Laboratory, Faculty of Sciences, Abdelmalek Essaadi University} and Bakhadda, M. and Bouzelmate, A. and {LaR2A Laboratory, Faculty of Sciences, Abdelmalek Essaadi University}},
	year = {2023},
	pages = {1093--1099},
	file = {PDF:/Users/saramesbah/Zotero/storage/EHI9J37X/LaR2A Laboratory, Faculty of Sciences, Abdelmalek Essaadi University et al. - 2023 - On the radial solutions of a p-Laplace equation with the Hardy potential.pdf:application/pdf},
}

