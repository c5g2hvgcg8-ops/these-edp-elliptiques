@article{elkhamlichi_variational_2027,
	title = {Variational analysis and numerical approximations for a class of quasilinear elliptic equations},
	volume = {11},
	issn = {2837-0562},
	url = {https://www.aimsciences.org//article/doi/10.3934/cac.2026.100091},
	doi = {10.3934/cac.2026.100091},
	abstract = {This paper studies the existence, conditional uniqueness, and numerical approximation of weak solutions for a class of quasilinear elliptic equations. The problem involves a nonlinear principal operator with nonstandard growth, together with a superlinear reaction term. We demonstrate the existence of a nontrivial weak solution and prove uniqueness within the class of weak solutions with a commonL ∞ bound and bounded gradient, based on a variant of the Minimum Principle, established through a weak form of the Cerami–Palais–Smale condition. Under some general growth assumptions on the nonlinearity, combined with a non-resonance condition at zero involving the first eigenvalue of the p-Laplacian, we derive our main result. Some numerical simulations based on Physics-Informed Neural Networks (PINNs) are illustrated to support the theoretical existence results and investigate the influence of exponentspandson the solution behaviour.},
	language = {en},
	number = {0},
	urldate = {2026-11-14},
	journal = {Communications on Analysis and Computation},
	author = {Elkhamlichi, Aicha and Bouzelmate, Arij and El Yazidi, Youness},
	year = {2027},
	pages = {0--0},
	file = {PDF:/Users/saramesbah/Zotero/storage/V8RH5ZTK/Elkhamlichi et al. - 2027 - Variational analysis and numerical approximations for a class of quasilinear elliptic equations.pdf:application/pdf},
}

