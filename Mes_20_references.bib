@article{bouzelmate_renormalized_2026-1,
	title = {Renormalized solutions for a class of elliptic problems with degenerate coercivity and gradient-dependent nonlinearities},
	volume = {30},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {1991-8615, 2310-7081},
	url = {https://www.mathnet.ru/vsgtu2152},
	doi = {10.14498/vsgtu2152},
	abstract = {We consider a class of quasilinear elliptic equations of the form 𝐴𝑢 = 𝑓 (𝑥, 𝑢, ∇𝑢) in Ω, with zero Dirichlet boundary conditions, where the operator 𝐴 is non-coercive and the right-hand side depends nonlinearly on both the solution and its gradient. The analysis is carried out within the framework of renormalized solutions, which are particularly well suited for problems with non-integrable data and degenerate coercivity. We combine a truncation technique with suitable a priori estimates to overcome the lack of coercivity and the presence of gradient-dependent nonlinearities. Under appropriate growth conditions on the Carathéodory function 𝑓 (𝑥, 𝑠, 𝜉), we establish the existence of at least one renormalized solution. Moreover, some regularity properties of the obtained solution are derived. Our results extend previous contributions in the literature, particularly those concerning problems with measure data, to a more general setting that includes gradient-dependent nonlinearities. Future work may address uniqueness and further regularity properties.},
	language = {en},
	number = {3},
	urldate = {2026-11-14},
	journal = {Вестник Самарского государственного технического университета. Серия «Физико-математические науки»},
	author = {Bouzelmate, Arij and Hjiaj, Hassane and Raiss, Inssaf},
	year = {2026},
	pages = {567--586},
	file = {PDF:/Users/saramesbah/Zotero/storage/FIP5WIYV/Bouzelmate et al. - 2026 - Renormalized solutions for a class of elliptic problems with degenerate coercivity and gradient-depe.pdf:application/pdf},
}

